{
  "name": "@joshbochu/pi-code-tool-ts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Experimental TypeScript-first code-mode extension for Pi (scaffold only in M0.1)",
  "license": "MIT",
  "author": "joshbochu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshbochu/pi-code-tool-ts.git"
  },
  "homepage": "https://github.com/joshbochu/pi-code-tool-ts#readme",
  "bugs": {
    "url": "https://github.com/joshbochu/pi-code-tool-ts/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "code-mode",
    "bun",
    "typescript"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "smoke:pi": "bun scripts/smoke-pi.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/bun": "^1.3.14",
    "typescript": "^5.8.3"
  }
}
