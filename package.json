{
  "name": "pi-code-tool-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Experimental trust-gated TypeScript-first code-mode extension for Pi",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./src/extension.ts"]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "smoke:pi": "bun scripts/smoke-pi.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/bun": "^1.3.14",
    "typescript": "^5.8.3"
  }
}
